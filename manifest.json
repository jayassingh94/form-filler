{
  "manifest_version": 3,
  "name": "Form Filler",
  "version": "1.0.0",
  "description": "Fill web forms from your locally stored, encrypted profiles. AI sees only field labels, never your data.",
  "permissions": ["storage", "scripting", "alarms", "unlimitedStorage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Form Filler",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": ["picker/picker.html"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ]
}
